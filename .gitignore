# Per-machine compiled CUDA kernel library (forge/backend/cuda/build.py).
# Targets one specific GPU architecture and CUDA Toolkit install; never
# portable across machines, so it is never committed -- each machine
# compiles its own copy on first CUDA use.
forge/backend/cuda/_forge_cuda_kernels_*.dll
forge/backend/cuda/_forge_cuda_kernels_*.exp
forge/backend/cuda/_forge_cuda_kernels_*.lib

__pycache__/
*.pyc
.pytest_cache/
*.egg-info/

# Per-machine, per-developer IDE metadata (JetBrains project settings) --
# never portable across machines/editors, never committed (Milestone 62
# hygiene: removed from tracking, see docs/development/m61-framework-readiness.md).
.idea/

# Milestone 20 MNIST example: downloaded dataset and generated run artifacts
# (models/checkpoints) -- large, machine-local, and reproducible via
# `python -m examples.mnist.train --download`; never committed.
examples/mnist/data/
examples/mnist/artifacts*/

# Milestone 50 char-RNN example: generated run artifacts (models) --
# machine-local and reproducible via `python -m examples.char_rnn.train`;
# never committed. No downloaded data (the corpus is generated in-process).
examples/char_rnn/artifacts*/

# Milestone 54 word-RNN example: generated run artifacts (models) -- same
# reasoning as char-RNN above. No downloaded data (the corpus is generated
# in-process).
examples/word_rnn/artifacts*/

# Milestone 60 tabular regression example: generated run artifacts (models/
# checkpoints) -- machine-local and reproducible via
# `python -m examples.regression.train`; never committed. No downloaded data
# (the dataset is generated in-process).
examples/regression/artifacts*/

# Milestone 62 waveform classification example: generated run artifacts
# (models/checkpoints) -- same reasoning as regression above. No downloaded
# data (the dataset is generated in-process).
examples/waveform_classification/artifacts*/

# Milestone 63 convolutional autoencoder example: generated run artifacts
# (models/checkpoints) -- machine-local and reproducible via
# `python -m examples.autoencoder.train`; never committed. Uses
# examples/mnist/data by default for its MNIST files (already ignored
# above), not its own data directory.
examples/autoencoder/artifacts*/

# Milestone 64 segmentation example: generated run artifacts (models/
# checkpoints) -- machine-local and reproducible via
# `python -m examples.segmentation.train`; never committed. No downloaded
# data (the synthetic shape dataset is generated in-process).
examples/segmentation/artifacts*/
